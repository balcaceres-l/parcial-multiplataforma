@model Frontend.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Grupo Empresarial Nova &mdash; Iniciar Sesión</h5>
            </div>
            <div class="card-body">
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Usuario</label>
                        <input asp-for="Username" class="form-control" id="inputUser" placeholder="Ej. admin, admin2, solicitante1, solicitante2" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contraseña</label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control" id="inputPass" value="Pass123!" />
                            <button class="btn btn-outline-secondary" type="button" id="btnTogglePass" onclick="togglePassword()">
                                Mostrar
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                </form>

                <hr />
                <p class="small text-muted mb-2"><strong>Selecciona una cuenta de prueba (Contraseña: <code>Pass123!</code>):</strong></p>

                <div class="mb-2 small fw-bold text-uppercase text-secondary">Rol 1: Solicitante (Solo tiene acceso a sus propias solicitudes)</div>
                <div class="d-grid gap-2 mb-3">
                    <button type="button" class="btn btn-outline-info text-dark btn-sm text-start" onclick="fillCreds('solicitante1')">
                        <strong>solicitante1</strong> &mdash; Carlos Méndez (Infraestructura TI) &bull; <em>Solo ve sus solicitudes</em>
                    </button>
                    <button type="button" class="btn btn-outline-info text-dark btn-sm text-start" onclick="fillCreds('solicitante2')">
                        <strong>solicitante2</strong> &mdash; María Fernanda Ruiz (Redes y Telecomunicaciones) &bull; <em>Solo ve sus solicitudes</em>
                    </button>
                </div>

                <div class="mb-2 small fw-bold text-uppercase text-secondary">Rol 2: Admin (Ve todas las solicitudes, aprueba, emite orden y audita cambios)</div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-dark btn-sm text-start" onclick="fillCreds('admin')">
                        <strong>admin</strong> &mdash; Luis Felipe Balcaceres Silvestre (Dirección General) &bull; <em>Acceso total y auditoría</em>
                    </button>
                    <button type="button" class="btn btn-outline-dark btn-sm text-start" onclick="fillCreds('admin2')">
                        <strong>admin2</strong> &mdash; Ana López (Gerencia y Compras) &bull; <em>Acceso total y auditoría</em>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCreds(user) {
            document.getElementById('inputUser').value = user;
            document.getElementById('inputPass').value = 'Pass123!';
        }

        function togglePassword() {
            var passInput = document.getElementById('inputPass');
            var btn = document.getElementById('btnTogglePass');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                btn.textContent = 'Ocultar';
            } else {
                passInput.type = 'password';
                btn.textContent = 'Mostrar';
            }
        }
    </script>
}
