@model Frontend.Models.CrearSolicitudVm
@{
    ViewData["Title"] = "Registrar Solicitud (RF1)";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">RF1: Registro de Solicitud de Compra</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info small py-2">
                    <strong>Regla de Negocio 1:</strong> El monto estimado debe ser mayor a 0 y la justificación es obligatoria.
                    Toda solicitud inicia con estado <strong>Pendiente</strong>.
                </div>

                <form asp-action="Crear" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Departamento Solicitante *</label>
                        <input asp-for="Departamento" class="form-control" placeholder="Ej. Infraestructura TI, Redes, Ventas..." />
                        <span asp-validation-for="Departamento" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción de Productos Tecnológicos / Suministros *</label>
                        <input asp-for="Descripcion" class="form-control" placeholder="Ej. 10 Monitores Ultrawide LG 29 pulgadas + Cables HDMI" />
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Justificación de la Compra * (Regla 1)</label>
                        <textarea asp-for="Justificacion" class="form-control" rows="3" placeholder="Explique el motivo operativo por el cual se requiere esta compra..."></textarea>
                        <span asp-validation-for="Justificacion" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Monto Estimado (USD) * (Regla 1: &gt; 0)</label>
                            <input asp-for="MontoEstimado" type="number" step="0.01" class="form-control" placeholder="Ej. 2450.00" />
                            <span asp-validation-for="MontoEstimado" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Imagen de Cotización / Producto (Opcional)</label>
                            <input asp-for="Imagen" type="file" accept="image/*" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Registrar Solicitud (Estado: Pendiente)</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
