@model Frontend.Models.LogsApiResponse
@{
    ViewData["Title"] = "Logs TXT y Middlewares";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Registro de Operaciones, Errores y Conflictos en Archivo TXT</h4>
        <small class="text-muted">Archivo en Backend: <code>@Model.Archivo</code> (@Model.TotalLineas entradas recientes)</small>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="ProbarExcepcion" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                Probar Middleware #2 (Excepción Global JSON + X-Request-Id)
            </button>
        </form>
        <a asp-action="Logs" class="btn btn-dark btn-sm">Actualizar Logs</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white d-flex justify-content-between">
        <span>Contenido de <code>Logs/operaciones.txt</code> (Más recientes primero)</span>
        <span class="badge bg-secondary">Incluye Fecha, Hora y X-Request-Id</span>
    </div>
    <div class="card-body bg-black text-light p-3" style="font-family: Consolas, monospace; font-size: 0.85rem; max-height: 550px; overflow-y: auto;">
        @if (Model.Logs.Length == 0)
        {
            <div class="text-muted">Aún no hay registros en el archivo TXT.</div>
        }
        else
        {
            @foreach (var line in Model.Logs)
            {
                var colorClass = "text-light";
                if (line.Contains("[CONFLICTO_CONCURRENCIA]")) colorClass = "text-warning fw-bold";
                else if (line.Contains("[ERROR")) colorClass = "text-danger";
                else if (line.Contains("[ORDEN_EMITIDA]")) colorClass = "text-success fw-bold";
                else if (line.Contains("[SOLICITUD_APROBADA]")) colorClass = "text-info";

                <div class="@colorClass border-bottom border-secondary py-1">@line</div>
            }
        }
    </div>
</div>
