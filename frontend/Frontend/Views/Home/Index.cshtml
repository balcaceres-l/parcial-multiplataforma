@{
    ViewData["Title"] = "Inicio";
    var health = ViewBag.ApiHealth as Frontend.Services.ApiHealthResponse;
    var baseUrl = ViewBag.ApiBaseUrl as string;
}

<div class="text-center py-4">
    <h1 class="display-5 fw-bold">Plataforma Parcial 3 (.NET 10)</h1>
    <p class="lead text-muted">ASP.NET Core MVC conectado por HTTP a ASP.NET Core Web API</p>

    <div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <span>Estado de Conexión con Backend API</span>
            <span class="badge @(health != null ? "bg-success" : "bg-danger")">
                @(health != null ? "CONECTADO" : "SIN CONEXIÓN")
            </span>
        </div>
        <div class="card-body text-start">
            <p class="mb-2"><strong>URL del Backend:</strong> <code>@baseUrl</code></p>
            @if (health != null)
            {
                <p class="mb-2"><strong>Servicio:</strong> @health.Service</p>
                <p class="mb-2"><strong>Módulos preparados:</strong></p>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var feat in health.Features)
                    {
                        <span class="badge bg-primary">@feat</span>
                    }
                </div>
                <small class="text-muted">Respuesta UTC: @health.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    El Frontend MVC está listo para consumir la API en <code>@baseUrl</code>. Inicia el proyecto <strong>Api</strong> para ver el estado en línea.
                </div>
            }
        </div>
    </div>
</div>
